# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
#
# Clave de firma JWT (OBLIGATORIA en producción). Si la dejás vacía, la app
# genera una efímera al arrancar y los tokens se invalidan en cada reinicio.
# Generá una fuerte con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Resumen diario con Gemini (Google AI): usa una de las dos variables
# (misma clave de https://aistudio.google.com/apikey )
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Base de datos (solo si corres uvicorn fuera de Docker)
# DATABASE_URL=postgresql://taskflow:taskflow_secret@localhost:5432/taskflow_db

# Contraseña inicial de usuarios creados por API (por defecto taskflow123)
# DEFAULT_NEW_USER_PASSWORD=taskflow123
