# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
#
# Entorno: development | production | test
# En production la app NO arranca sin SECRET_KEY ni SIGAO_API_KEY.
ENVIRONMENT=development

# Clave de firma JWT (OBLIGATORIA en production). Si la dejás vacía fuera de
# production, la app genera una efímera al arrancar y los tokens se invalidan
# en cada reinicio. Generá una fuerte con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Resumen diario con Gemini (Google AI): usa una de las dos variables
# (misma clave de https://aistudio.google.com/apikey )
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Base de datos (solo si corres uvicorn fuera de Docker)
# DATABASE_URL=postgresql://taskflow:taskflow_secret@localhost:5435/taskflow_db

# Contraseña inicial de usuarios creados por admin API.
# El alta setea must_change_password=true; el FE fuerza el cambio en el primer login.
# DEFAULT_NEW_USER_PASSWORD=taskflow123

# Integración SIGAO (Proyectos Estratégicos). MUST match SIGAO's TASKFLOW_SIGAO_API_KEY.
# OBLIGATORIA en production. En development puede quedar vacía (los endpoints
# SIGAO responden 503 SIGAO_NOT_CONFIGURED).
# Para local con integración: exportá TASKFLOW_SIGAO_API_KEY o definí aquí.
SIGAO_API_KEY=
